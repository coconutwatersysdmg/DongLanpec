      <property name="styleSheet">
       <string notr="true">QFrame#frame_title_bar {
    background-color: #003366;
    border: none;
}
QLabel#label_main_title {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}
/* 0522新修改：顶部导航栏按钮（QToolButton 上下布局、16px 字号） */
QFrame#frame_nav_strip {
    background-color: #FFF;
    border: none;
    border-bottom: 1px solid #b8c9e8;
}
QFrame#frame_nav_strip QPushButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 8px;
    min-width: 78px;
    min-height: 76px;
    max-height: 92px;
    font-size: 16px;
    color: #003366;
    font-family: &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;;
}
QFrame#frame_nav_strip QPushButton:hover {
    background-color: #cfe0ff;
    border-color: #9ebce0;
}
QFrame#frame_nav_strip QPushButton:pressed {
    background-color: #ffe4c4;
    border-color: #e8b896;
}
QFrame#frame_nav_strip QPushButton:disabled {
    color: #999999;
    background-color: #eef3f9;
}
QFrame#frame_nav_strip QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 8px;
    min-width: 78px;
    min-height: 76px;
    max-height: 92px;
    font-size: 16px;
    color: #003366;
    font-family: &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;;
}
QFrame#frame_nav_strip QToolButton:hover {
    background-color: #cfe0ff;
    border-color: #9ebce0;
}
QFrame#frame_nav_strip QToolButton:pressed {
    background-color: #ffe4c4;
    border-color: #e8b896;
}
QFrame#frame_nav_strip QToolButton:disabled {
    color: #999999;
    background-color: #eef3f9;
}
/* 0522新修改：配置按钮下拉箭头右侧居中、加大 */
QFrame#frame_nav_strip QToolButton#btn_config {
    padding-right: 18px;
}
QFrame#frame_nav_strip QToolButton#btn_config::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 14px;
    height: 14px;
    right: 2px;
}
QFrame#current_product {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
}
QFrame#current_product QLabel {
    background-color: transparent;
    font-size: 14px;
}
</string>
