  <property name="styleSheet">
   <string notr="true">QWidget#Form {
    background-color: #f3f5f8;
    color: #1f1f1f;
}

QLabel#label_7,
QLabel#label_6,
QLabel#label_5 {
    background-color: #E6F0FF;
    color: #003399;
    border: 1px solid #CCCCCC;
    min-height: 45px;
    max-height: 45px;
    padding-left: 8px;
    font-weight: 600;
}

QGroupBox#groupBox_3,
QGroupBox#groupBox,
QGroupBox#groupBox_4,
QGroupBox#groupBox_5,
QGroupBox#groupBox_6,
QGroupBox#groupBox_7,
QGroupBox#groupBox_8 {
    background-color: #ffffff;
    border: 1px solid #CCCCCC;
    margin-top: 0px;
}

QGroupBox::title {
    color: transparent;
}

QTableWidget#tableWidget,
QTableWidget#tableWidget_define1,
QTableWidget#tableWidget_define1_5,
QTableWidget#tableWidget_para,
QTableWidget#tableWidget_define1_2,
QTableWidget#tableWidget_define1_3,
QTableWidget#tableWidget_define1_4 {
    background-color: #ffffff;
    alternate-background-color: #f7f9fc;
    border: 1px solid #CCCCCC;
    gridline-color: #CCCCCC;
    color: #1f1f1f;
    selection-background-color: #d9e6f7;
    selection-color: #1f1f1f;
}

QHeaderView::section {
    background-color: #f3f5f8;
    color: #1f1f1f;
    border: 1px solid #CCCCCC;
    padding: 4px 6px;
    font-weight: 600;
}

QTabWidget::pane {
    border: 1px solid #CCCCCC;
    background-color: #ffffff;
    top: -1px;
}

/* 标签靠左、不拉伸铺满（必须用 QTabWidget::tab-bar，QTabBar{alignment} 无效） */
QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background-color: #f6f8fb;
    color: #333333;
    border: 1px solid #CCCCCC;
    border-bottom: none;
    padding: 4px 8px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1f1f1f;
}

QGroupBox#groupBox {
    padding: 0px;
    margin-top: 0px;
}

QLabel#label_4 {
    background-color: #ffffff;
    border: none;
    color: #8a97a8;
    padding: 0px;
}

/* 与项目管理 guanli_new.ui / ui_style.py 按钮样式一致 */
QPushButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #ffffff, stop: 1 #e8edf5);
    border: 1px solid #b8c8e0;
    border-radius: 0px;
    color: #000000;
    font-size: 17px;
    padding: 8px 20px;
    text-align: center;
    min-width: 65px;
}

QPushButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #f0f4fa, stop: 1 #d8e0ed);
    border-color: #9ab0d0;
}

QPushButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #e0e6f0, stop: 1 #c8d2e0);
    border-color: #7a90b0;
}

QPushButton:disabled {
    background: #f5f7fa;
    color: #888888;
    border-color: #d0d8e5;
}

QLineEdit#lineEdit {
    min-width: 170px;
}

QLineEdit,
QLineEdit#lineEdit_2 {
    background-color: #ffffff;
    border: 1px solid #CCCCCC;
    color: #1f1f1f;
    min-height: 22px;
    padding: 0px 4px;
}

/* 所有下拉框统一：外框 #CCCCCC，右侧箭头区透明无底边，避免系统灰底黑边 */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #CCCCCC;
    color: #1f1f1f;
    min-height: 22px;
    padding: 1px 16px 1px 4px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 14px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(modules/cailiaodingyi/ui/combo_arrow_gray.svg);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #CCCCCC;
    selection-background-color: #d9e6f7;
    selection-color: #1f1f1f;
}

/* 详细定义底部「清空/确定」沿用全局 QPushButton 项目管理样式 */

/* Tab 右键菜单：避免悬停时文字与背景同色导致看不见 */
QMenu {
    background-color: #ffffff;
    border: 1px solid #CCCCCC;
    color: #1f1f1f;
}

QMenu::item {
    color: #1f1f1f;
    padding: 6px 24px;
}

QMenu::item:selected {
    background-color: #d9e6f7;
    color: #1f1f1f;
}</string>
