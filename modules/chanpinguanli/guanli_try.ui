  <property name="styleSheet">
   <string notr="true">/* 项目产品管理界面 — 与效果图：浅蓝分区头 #E6F0FF、标题字色 #003399、细灰边 #CCCCCC */
QWidget#main_layout {
    background-color: #eceff4;
}
QLabel#label_section_project_list,
QLabel#label_section_project_info,
QLabel#label_section_product_info,
QLabel#label_section_product_def,
QLabel#label_section_work_info,
QLabel#label_section_image {
    background-color: #e6f0ff;
    color: #003399;
    font-weight: bold;
    font-size: 11pt;
    padding: 5px 8px 5px 6px;
    min-height: 28px;
    max-height: 28px;
    qproperty-alignment: 'AlignVCenter|AlignLeft';
    border: 1px solid #cccccc;
    border-bottom: none;
}
QFrame#frame_project_sidebar {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    margin-top: -2px;
}
QFrame#frame_project_info_wrap,
QFrame#frame_product_info_wrap {
    background-color: #ffffff;
    border: 1px solid #cccccc;
}
QLineEdit, QComboBox, QDateEdit {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    padding: 3px 6px;
    min-height: 22px;
    font-size: 10pt;
}
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f2f2f2;
    gridline-color: #cccccc;
    border: 1px solid #cccccc;
    font-size: 10pt;
}
QHeaderView::section {
    background-color: #f0f4fa;
    color: #333333;
    padding: 4px;
    border: 1px solid #cccccc;
}
QTableWidget::item:selected {
    background-color: #cce8ff;
    color: #000000;
}
QPushButton#new_project_btn {
    background-color: #1a5fb4;
    color: #ffffff;
    border: 1px solid #0d3d82;
    border-radius: 2px;
    min-width: 32px;
    max-width: 36px;
    min-height: 26px;
    max-height: 28px;
    font-weight: bold;
    font-size: 14pt;
    padding: 0px;
}
QPushButton#delete_project_btn {
    background-color: #ff8c42;
    color: #ffffff;
    border: 1px solid #e07020;
    border-radius: 2px;
    min-width: 32px;
    max-width: 36px;
    min-height: 26px;
    max-height: 28px;
    font-weight: bold;
    font-size: 14pt;
    padding: 0px;
}
QPushButton#confirm_project_btn,
QPushButton#confirm_product_btn,
QPushButton#confirm_definition_btn {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #fafafa, stop:1 #e8e8e8);
    border: 1px solid #b0b0b0;
    border-radius: 3px;
    padding: 5px 14px;
    color: #333333;
    min-height: 24px;
    max-height: 28px;
}
QPushButton#modify_product_btn,
QPushButton#delete_product_btn {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #fafafa, stop:1 #e8e8e8);
    border: 1px solid #b0b0b0;
    border-radius: 3px;
    padding: 6px 8px;
    min-width: 76px;
<!--    min-height: 46px;修改删除按钮高度-->
}
QGroupBox#product_definition_group,
QGroupBox#work_information_group {
    border: 1px solid #cccccc;
    margin-top: 0px;
    padding-top: 0px;
    background-color: #ffffff;
}
QGroupBox#product_definition_group::title,
QGroupBox#work_information_group::title {
    subcontrol-origin: margin;
    left: 0px;
    padding: 0px 0px;
    height: 0px;
    width: 0px;
}
QFrame#image_area {
    background-color: #ffffff;
    border: 1px solid #cccccc;
}
QRadioButton {
    font-size: 10pt;
    color: #333333;
}</string>
