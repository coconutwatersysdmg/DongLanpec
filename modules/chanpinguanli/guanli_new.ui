  <property name="styleSheet">
   <string notr="true">QPushButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #ffffff, stop: 1 #e8edf5);
    border: 1px solid #b8c8e0;
    border-radius: 0px;
    color: #000000;
    font-size: 17px;
    padding: 8px 20px;
    text-align: center;
    min-width: 65px;
}

QPushButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #f0f4fa, stop: 1 #d8e0ed);
    border-color: #9ab0d0;
}

QPushButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #e0e6f0, stop: 1 #c8d2e0);
    border-color: #7a90b0;
}

QPushButton:disabled {
    background: #f5f7fa;
    color: #888888;
    border-color: #d0d8e5;
}

#project_path_button {
    font-size: 14px;
    padding: 0px 6px;
    border: 1px solid #ccc;
    background-color: #f0f0f0;
    min-width: 28px;
}
#project_path_button:hover {
    background-color: #e0e0e0;
}

/* 隐藏边框、背景，并彻底清除QGroupBox的所有边距 */
QGroupBox, #image_area {
    border: none;
    background-color: transparent;
    margin: 0px;
    padding: 0px;
}

/* 强制清除QGroupBox内部的内容边距（关键！） */
QGroupBox {
    qproperty-contentMargins: 0, 0, 0, 0;
}

/* 0522新修改：统一标题样式（已去掉 margin-left:-9px，避免项目信息偏左） */
/* 统一标题 Label 样式（去掉边框，固定高度） */
QLabel#label, QLabel#label_2, QLabel#label_3, QLabel#label_4 {
background-color: #e6f0ff;    /* 背景色：淡蓝色 */
color: #003399;                /* 文字颜色：深蓝色 */
font-weight: bold;             /* 文字加粗 */
font-size: 12pt;               /* 文字大小：12号 */
padding: 6px 10px;             /* 内边距：上下6px，左右10px */
border: none;                  /* 无边框 */
}
/* 滚动条整体样式 */
QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 14px;
    margin: 0px;
}

/* 滚动条滑块 */
QScrollBar::handle:vertical {
    background-color: #c4c4c4;
    border-radius: 7px;
    min-height: 30px;
}

/* 滑块悬浮 */
QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

/* 滑块按下 */
QScrollBar::handle:vertical:pressed {
    background-color: #888888;
}

/* 滚动条上下箭头（隐藏） */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

/* 滚动条背景区域 */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}</string>
  </property>
