            <widget class="QPushButton" name="save_btn">
             <property name="styleSheet">
              <string notr="true">QPushButton {
    /* 背景：纯白，无渐变 */
    background-color: #FFFFFF;
    /* 边框：浅灰色细线 */
    border: 1px solid #E0E0E0;
    /* 圆角：8px，和参考图一致 */
    border-radius: 8px;
    /* 文字样式 */
    color: #000000;
    font-size: px;
    /* 内边距，让文字居中 */
    padding: 6px 16px;
    /* 鼠标悬浮时的过渡效果 */
    transition: all 0.2s ease;
}

/* 鼠标悬浮效果：轻微加深边框 + 浅背景 */
QPushButton:hover {
    background-color: #F5F5F5;
    border-color: #D0D0D0;
}

/* 点击效果：按下时轻微变暗 */
QPushButton:pressed {
    background-color: #EEEEEE;
    border-color: #C0C0C0;
}

/* 禁用状态样式（可选） */
QPushButton:disabled {
    background-color: #FAFAFA;
    color: #AAAAAA;
    border-color: #E5E5E5;
}
</string>
