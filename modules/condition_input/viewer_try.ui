     <property name="styleSheet">
      <string notr="true">QComboBox#combo_mode {
    min-height: 32px;
    padding: 2px 30px 2px 10px; /* 右侧留出下拉按钮空间 */
    border: 1px solid #c9c9c9;
    border-radius: 2px;
    background-color: #f7f7f7;
}
QComboBox#combo_mode::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #d6d6d6;
    background-color: #f0f0f0;
}

QToolButton#btn_inputrefdata,
QToolButton#btn_output,
QToolButton#toolButton_3,
QToolButton#btn_confirm {
    min-height: 38px;
    max-height: 38px;
    padding: 4px 12px;
    border: 1px solid #bdbdbd;
    border-radius: 3px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #ffffff, stop:1 #ececec);
    color: #333333;
}
QToolButton#btn_inputrefdata:hover,
QToolButton#btn_output:hover,
QToolButton#toolButton_3:hover,
QToolButton#btn_confirm:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #ffffff, stop:1 #dfeafc);
    border-color: #8fb0e6;
}
QToolButton#btn_inputrefdata:pressed,
QToolButton#btn_output:pressed,
QToolButton#toolButton_3:pressed,
QToolButton#btn_confirm:pressed {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #e6e6e6, stop:1 #f5f5f5);
    border-color: #9c9c9c;
}</string>
