     <property name="styleSheet">
      <string notr="true">QGroupBox#groupBox_condition_input { border: none; }


QPushButton#btn_inputrefdata,
QPushButton#btn_output,
QPushButton#toolButton_3,
QPushButton#btn_confirm {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #ffffff, stop: 1 #e8edf5);
    border: 1px solid #b8c8e0;
    border-radius: 0px;
    color: #000000;
    font-size: 17px;
    padding: 8px 20px;
    text-align: center;
    min-width: 65px;


}
QPushButton#btn_inputrefdata:hover,
QPushButton#btn_output:hover,
QPushButton#toolButton_3:hover,
QPushButton#btn_confirm:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #f0f4fa, stop: 1 #d8e0ed);
    border-color: #9ab0d0;
}
QPushButton#btn_inputrefdata:pressed,
QPushButton#btn_output:pressed,
QPushButton#toolButton_3:pressed,
QPushButton#btn_confirm:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #e0e6f0, stop: 1 #c8d2e0);
    border-color: #7a90b0;
}
QPushButton#btn_inputrefdata:disabled,
QPushButton#btn_output:disabled,
QPushButton#toolButton_3:disabled,
QPushButton#btn_confirm:disabled {
    background: #f5f7fa;
    color: #888888;
    border-color: #d0d8e5;
}</string>
